{
  "manifest_version": 3,
  "name": "FloatLyrics",
  "version": "0.5.2",
  "description": "Helper for the FloatLyrics app: gives it the exact playback position of YouTube, YouTube Music, Spotify and Apple Music in the browser. On its own it shows lyrics in a floating window.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://lrclib.net/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FloatLyrics — open a music tab and click “♪ Lyrics”"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*", "https://open.spotify.com/*", "https://music.apple.com/*", "https://beta.music.apple.com/*"],
      "js": ["probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*", "https://open.spotify.com/*", "https://music.apple.com/*", "https://beta.music.apple.com/*"],
      "js": ["core.js", "glass.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
